{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "\"${COPILOT_PLUGIN_ROOT}/hooks/session-start.sh\" copilot",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "view|task|bash",
        "bash": "\"${COPILOT_PLUGIN_ROOT}/hooks/pre-tool-use.sh\"",
        "timeoutSec": 5
      }
    ]
  }
}
