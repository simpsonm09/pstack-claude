{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "\"${COPILOT_PLUGIN_ROOT}/hooks/session-start.sh\" copilot",
        "powershell": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$env:COPILOT_PLUGIN_ROOT/hooks/session-start-copilot.ps1\"",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "view|task|bash",
        "bash": "\"${COPILOT_PLUGIN_ROOT}/hooks/pre-tool-use.sh\"",
        "powershell": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$env:COPILOT_PLUGIN_ROOT/hooks/pre-tool-use-windows.ps1\"",
        "timeoutSec": 10
      }
    ]
  }
}
